# Configuração (veja o README para o passo a passo).
# Copie este arquivo para ".env" e preencha os valores.
#
# NÃO há login de usuário: o acesso ao Drive é feito apenas com a API Key,
# então a pasta precisa estar compartilhada como
# "Qualquer pessoa com o link pode ver".

# Chave de API do Google Cloud (restrinja à Google Drive API).
VITE_GOOGLE_API_KEY=

# ID da pasta do Google Drive com as planilhas.
# (parte da URL depois de /folders/)
VITE_DRIVE_FOLDER_ID=1TcjOORLTuv7YGPIHdgXI9tb0xiVQP3VA
